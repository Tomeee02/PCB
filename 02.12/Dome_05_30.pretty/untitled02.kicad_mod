(module "Snaptron_DomeSwitch_7mm" (layer "F.Cu") (tedit 5B3072D0)
  (descr "7mm Dome Switch, Double-Sided, Based on Snaptron Specs")
  (tags "dome switch snaptron")
  (attr smd)
  (fp_text reference "SW1" (at 0 -4.5) (layer "F.SilkS") hide (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "DomeSwitch_7mm" (at 0 4.5) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))

  ;; Courtyard
  (fp_circle (center 0 0) (end 3.75 0) (layer "F.CrtYd") (width 0.05))

  ;; Silk outline
  (fp_circle (center 0 0) (end 3.5 0) (layer "F.SilkS") (width 0.12))

  ;; Solder mask keepout (dome center)
  (fp_circle (center 0 0) (end 1.5 0) (layer "F.Mask") (width 1.5) (fill none))

  ;; Pads
  (pad "1" thru_hole circle (at -2.86 0) (size 1.5 1.5) (drill 0.8) (layers *.Cu *.Mask))
  (pad "2" thru_hole circle (at 0 5.45) (size 1.5 1.5) (drill 0.8) (layers *.Cu *.Mask))
  (pad "3" thru_hole circle (at 6.93 0) (size 1.5 1.5) (drill 0.8) (layers *.Cu *.Mask))

  ;; Dome center hole (optional plated or NPTH)
  (pad "4" np_thru_hole circle (at 0 0) (size 0.6 0.6) (drill 0.6) (layers F&B.Cu))

)
