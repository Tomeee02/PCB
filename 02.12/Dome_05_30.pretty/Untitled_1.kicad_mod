(kicad_mod (version 20211014) (generator chatgpt)
  (module "Snaptron_DomeSwitch_7mm_SMD" (layer "F.Cu") (tedit 5B3072D0)
    (descr "7mm Dome Switch, Double-Sided SMD, Based on Snaptron Specs")
    (tags "dome switch snaptron SMD")

    ;; Reference and Value
    (fp_text reference "SW1" (at 0 -4.5) (layer "F.SilkS") hide
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_text value "DomeSwitch_7mm_SMD" (at 0 4.5) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.15)))
    )

    ;; Courtyard
    (fp_circle (center 0 0) (end 3.75 0) (layer "F.CrtYd") (width 0.05))

    ;; Silk outline
    (fp_circle (center 0 0) (end 3.5 0) (layer "F.SilkS") (width 0.12))

    ;; Pads (SMD rectangular)
    (pad "1" smd rect (at -2.86 0) (size 1.6 1.6) (layers "F.Cu" "F.Paste" "F.Mask"))
    (pad "2" smd rect (at 0 5.45) (size 1.6 1.6) (layers "F.Cu" "F.Paste" "F.Mask"))
    (pad "3" smd rect (at 6.93 0) (size 1.6 1.6) (layers "F.Cu" "F.Paste" "F.Mask"))

    ;; Optional center hole (not plated)
    (pad "" np_thru_hole circle (at 0 0) (size 0.6 0.6) (drill 0.6) (layers *.Mask))

    ;; Optional solder mask keepout (central dome contact area)
    (fp_circle (center 0 0) (end 1.5 0) (layer "F.Mask") (width 1.5) (fill none))
  )
)
